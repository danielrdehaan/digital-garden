# Git LFS tracking for large binary files
# These files will be stored in LFS instead of the main repository

# Archive files
*.zip filter=lfs diff=lfs merge=lfs -text
# Video files
*.mov filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# Audio files
*.wav filter=lfs diff=lfs merge=lfs -text
# Image files (large animations)
*.gif filter=lfs diff=lfs merge=lfs -text

#fmod stuff
Assets/Plugins/FMOD/**/*.bundle text eol=lf
Assets/Plugins/FMOD/**/Info.plist text eol=lf
