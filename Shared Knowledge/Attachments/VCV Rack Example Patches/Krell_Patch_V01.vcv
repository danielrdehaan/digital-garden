    {
      "id": 8,
      "plugin": "Core",
      "version": "1.1.6",
      "model": "Notes",
      "params": [],
      "leftModuleId": 154,
      "text": "MASTER VOLUME\n---------------------------------\nThe \"Level\" knob on the mixer just below and to the left controls the overall volume for this patch.\n------------------------------------------------------------------\nThe Krell Patch\n---------------------------------\nThis patch explores the use of a looping envelope generator (Befaco's Rampage) along with several sources of randomness to create randomly generated melodies. \n\nThis is a classic patch that was inspired by the music of the Ancient Krell from the 1956 movie Forbidden Planet,",
      "pos": [
        127,
        0
      ]
    },
